# ==========================
# Application
# ==========================
APP_NAME=Control Smart Devices
APP_ENV=development
DEBUG=True

# ==========================
# FastAPI Server
# ==========================
HOST=0.0.0.0
PORT=8000

# ==========================
# PostgreSQL
# ==========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=smart_home
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_home

# ==========================
# JWT Authentication
# ==========================
SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# MQTT Broker
# ==========================
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# ==========================
# WebSocket
# ==========================
WS_URL=ws://localhost:8000/ws

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO